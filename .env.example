# Google Apps Script Web App URL — 신청 데이터를 받아서 구글 시트에 저장하는 엔드포인트
# 설정 방법은 docs/GOOGLE_SHEETS_SETUP.md 참고
GOOGLE_SHEETS_WEBHOOK_URL=

# 인천(/0709-10incheon) 전용 시트 웹훅 — 미설정 시 위 기본 웹훅으로 폴백
GOOGLE_SHEETS_WEBHOOK_URL_INCHEON=

# Compass(mkt.classin.co.kr) 방문 웹훅 — 방문 로그를 crm.page_visits 에도 쌓는다
COMPASS_VISIT_URL=
# Compass VISIT_INGEST_TOKEN 과 같은 값
COMPASS_VISIT_TOKEN=

# Compass 신청 웹훅 — 설명회 신청을 콜 목록 리드로 바로 넣는다(Compass ADR-0102). Compass EVENT_SIGNUP_TOKEN 과 같은 값.
# 비우면 보내지 않는다(시트 「Compass」 칸 「꺼짐」)
COMPASS_SIGNUP_TOKEN=
# 선택 — 비우면 COMPASS_VISIT_URL 의 page-visit 을 event-signup 으로 바꿔 쓴다
COMPASS_SIGNUP_URL=
